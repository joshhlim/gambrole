# Copy to api/.env for local development. Never commit the real file.

TAIDI_DATABASE_URL=postgresql+asyncpg://gambrole:gambrole_dev@localhost:5433/gambrole

# "dev": POST /auth/dev-login mints tokens locally, no external auth needed.
# "supabase": verify tokens against a real Supabase project instead.
TAIDI_AUTH_MODE=dev
TAIDI_DEV_JWT_SECRET=dev-only-insecure-secret-change-me

# Only used when TAIDI_AUTH_MODE=supabase — set ONE of these two,
# depending on which your Supabase project shows you (Project Settings ->
# API): a newer project shows a "JWT Signing Key" with no plain secret to
# reveal (use TAIDI_SUPABASE_URL, verified via the project's public JWKS
# endpoint); an older project shows a "JWT Secret" / "Legacy JWT Secret"
# you can reveal directly (use TAIDI_SUPABASE_JWT_SECRET). If both are
# set, TAIDI_SUPABASE_URL/JWKS wins.
# TAIDI_SUPABASE_URL=https://<project-ref>.supabase.co
# TAIDI_SUPABASE_JWT_SECRET=

# Local dev only needs :3000/:3100 (Next.js's default and this repo's
# convention, respectively). On the deployed API (Render), set this to a
# JSON array containing the Vercel URL instead, e.g.
# ["https://your-app.vercel.app"].
TAIDI_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3100"]
