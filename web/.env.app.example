# Copy to .env.app (not committed) for the iOS app build: `npm run build:app`
# builds the site with these values and copies it into ios/. Same values as
# the Vercel production environment, plus NEXT_PUBLIC_SITE_URL: inside the
# app the page's origin is capacitor://localhost, so share links and email
# redirects need the public address spelled out.
NEXT_PUBLIC_API_URL=https://gambrole-api-sg.onrender.com
NEXT_PUBLIC_SITE_URL=https://gambrole.vercel.app
NEXT_PUBLIC_AUTH_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable/anon key from Supabase project settings>
