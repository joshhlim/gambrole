{
  // Whole-repo dev environment: core/ + api/ (Python 3.13, same as CI and
  // Render), web/ (Node 22), the legacy Streamlit app, and Docker for the
  // local Postgres in docker-compose.yml.
  //   docker compose up -d postgres
  //   cd api && python -m alembic upgrade head && python -m uvicorn app.main:app --reload
  //   cd web && npm run dev -- --port 3100
  //   streamlit run taidi.py   (legacy app)
  "name": "GamBROle",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements-dev.txt && (cd web && npm ci)",
  "containerEnv": {
    "TAIDI_AUTH_MODE": "dev"
  },
  "forwardPorts": [3100, 8000, 8501],
  "portsAttributes": {
    "3100": { "label": "web" },
    "8000": { "label": "api" },
    "8501": { "label": "legacy Streamlit" }
  }
}
